---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE } from '../data/site';
import { breadcrumbs } from '../lib/schema';
import { SOBRE } from '../data/content';
import { paragraphs } from '../lib/md';

const crumbs = [{ name: 'Início', url: '/' }, { name: 'Sobre', url: '/sobre/' }];
const t = SOBRE;
---
<Base title="Sobre" description="A AJUSTAPREV atua em direito empresarial previdenciário com foco em custo, risco e conformidade da folha." schema={[breadcrumbs(crumbs)]}>
  <PageHeader eyebrow={t.eyebrow} title={t.titulo} lead={t.lead} crumbs={crumbs} />

  <section class="section">
    <div class="container sobre">
      <div class="prose" data-reveal set:html={paragraphs(t.texto)} />
      <ul role="list" class="valores" aria-label="Princípios da marca" data-reveal>
        {t.valores.map((v) => <li>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="p-title">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Como pensamos</span><h2 id="p-title">{t.principiosTitulo}</h2></div>
      <div class="grid grid--3">
        {t.principios.map((p, i) => (
          <article class="card" data-reveal style={`transition-delay:${i * 80}ms`}>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {(SITE.legal.responsibleName || SITE.legal.society) && (
    <section class="section" aria-labelledby="resp-title">
      <div class="container">
        <h2 id="resp-title" class="resp__h">Responsabilidade técnica</h2>
        <p>
          {SITE.legal.society}{SITE.legal.society && SITE.legal.responsibleName && ' — '}
          {SITE.legal.responsibleName}{SITE.legal.oab && `, ${SITE.legal.oab}`}
        </p>
      </div>
    </section>
  )}

  <CtaFinal />
</Base>

<style>
  .sobre { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(40px, 7vw, 112px); align-items: start; }
  .valores { border-top: 1px solid var(--line-strong); }
  .valores li { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--text-strong); }
  .valores li::before { content: ''; display: inline-block; width: 18px; height: 1px; background: var(--rule); vertical-align: middle; margin-right: 14px; }
  .resp__h { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
  @media (max-width: 900px) { .sobre { grid-template-columns: 1fr; } }
</style>
