---
import Icon from './Icon.astro';
import { DORES, HOME } from '../data/content';
const t = HOME.dores;
---
<section class="section dores" aria-labelledby="dores-title">
  <div class="dots" style="--dots-x: 85%; --dots-y: 10%" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="dores-title">{t.titulo}</h2>
      <p>{t.texto}</p>
    </div>

    <ol class="dores__list" role="list">
      {DORES.map((d, i) => (
        <li class="dores__item" data-reveal style={`transition-delay:${i * 80}ms`}>
          <span class="dores__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={d.icone} class="dores__icon" />
          <h3>{d.titulo}</h3>
          <p>{d.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .dores { background: var(--night); }
  .dores__list { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .dores__item {
    position: relative; padding: clamp(28px, 3vw, 40px) clamp(22px, 2.4vw, 32px) clamp(32px, 3.4vw, 44px);
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    transition: background-color 0.3s ease;
  }
  .dores__item::before {
    content: ''; position: absolute; left: -1px; top: -1px; width: 0; height: 2px; background: var(--rule);
    transition: width 0.5s var(--ease-build);
  }
  .dores__item:hover { background: rgba(31, 59, 91, 0.35); }
  .dores__item:hover::before { width: calc(100% + 2px); }
  .dores__n { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 36px; }
  .dores__item :global(.dores__icon) { color: var(--prev-hi); margin-bottom: 20px; }
  .dores__item h3 { margin-bottom: 12px; }
  .dores__item p { font-size: 0.94rem; font-weight: 300; line-height: 1.75; }
  @media (max-width: 1000px) { .dores__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .dores__list { grid-template-columns: 1fr; } .dores__n { margin-bottom: 20px; } }
</style>
