---
interface Crumb { name: string; url: string }
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: Crumb[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<header class="page-header">
  <div class="dots" style="--dots-x: 88%; --dots-y: 30%" aria-hidden="true"></div>
  <div class="container page-header__inner">
    {crumbs.length > 0 && (
      <nav aria-label="Trilha de navegação" class="crumbs">
        <ol role="list">
          {crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header { position: relative; overflow: hidden; padding: calc(var(--header-h) + clamp(48px, 7vw, 96px)) 0 clamp(48px, 6vw, 80px); background: linear-gradient(180deg, var(--brand-deep), var(--night)); border-bottom: 1px solid var(--line); }
  .page-header__inner { position: relative; z-index: 1; }
  .page-header h1 { max-width: 22ch; margin-bottom: 20px; }
  .page-header .lead { max-width: 60ch; }
  .crumbs { margin-bottom: 28px; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 0.76rem; color: var(--text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: 10px; color: var(--line-strong); }
  .crumbs a { color: var(--text); text-decoration: none; }
  .crumbs a:hover { color: var(--link); }
  .crumbs [aria-current] { color: var(--text-muted); }
</style>
