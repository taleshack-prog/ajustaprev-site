---
interface Props {
  items: readonly { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
  id?: string;
}
const { items, title = 'Perguntas frequentes', eyebrow = 'Antes do contato', id = 'faq' } = Astro.props;
---
<section class="section section--alt faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq__wrap">
    <div class="faq__head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="muted">Respostas diretas às dúvidas que costumam vir antes do diagnóstico.</p>
    </div>
    <div class="faq__list" data-reveal>
      {items.map((it) => (
        <details class="faq__item">
          <summary>
            <span>{it.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__wrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq__head { position: sticky; top: calc(var(--header-h) + 32px); }
  .faq__head h2 { margin-bottom: 16px; }
  .faq__list { border-top: 1px solid var(--line-strong); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    min-height: 44px; padding: 24px 0; cursor: pointer; list-style: none;
    font-size: 1.04rem; font-weight: 500; color: var(--text-strong); line-height: 1.45;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--link); }
  .faq__icon { position: relative; flex: none; width: 14px; height: 14px; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--prev-hi); transition: transform 0.3s var(--ease-build); }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__a { padding: 0 48px 26px 0; }
  .faq__a p { font-weight: 300; line-height: 1.8; }
  @media (max-width: 860px) {
    .faq__wrap { grid-template-columns: 1fr; }
    .faq__head { position: static; }
    .faq__a { padding-right: 0; }
  }
</style>
