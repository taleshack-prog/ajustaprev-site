---
import PostCard from './PostCard.astro';
import { getPosts } from '../lib/blog';
const posts = (await getPosts()).slice(0, 3);
---
{posts.length > 0 && (
  <section class="section section--deep blog-teaser" aria-labelledby="blog-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <span class="eyebrow">Conteúdo técnico</span>
          <h2 id="blog-title">Para quem decide sobre a folha.</h2>
          <p>Análises objetivas sobre custeio, enquadramento e risco previdenciário — com a norma citada.</p>
        </div>
        <a href="/blog/" class="btn btn--ghost btn--sm">Ver todos os artigos <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul role="list" class="grid grid--3">
        {posts.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`}><PostCard post={p} /></li>
        ))}
      </ul>
    </div>
  </section>
)}
