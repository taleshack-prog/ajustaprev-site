---
import { postUrl, readingTime, formatDate, type Post } from '../lib/blog';
interface Props { post: Post; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const { title, description, category, date } = post.data;
---
<article class="post-card" data-category={category} data-search={`${title} ${description} ${category}`.toLowerCase()}>
  <div class="post-card__meta">
    <span class="tag">{category}</span>
    <span class="post-card__time">{readingTime(post.body)} min</span>
  </div>
  <H class="post-card__title"><a href={postUrl(post)}>{title}</a></H>
  <p class="post-card__desc">{description}</p>
  <time class="post-card__date" datetime={date.toISOString()}>{formatDate(date)}</time>
</article>

<style>
  .post-card {
    position: relative; display: flex; flex-direction: column; gap: 16px; height: 100%;
    padding: clamp(24px, 2.6vw, 32px); background: var(--brand-deep);
    border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 0.25s ease, transform 0.25s var(--ease-build);
  }
  .post-card:hover, .post-card:focus-within { border-color: rgba(106,162,243,.55); transform: translateY(-2px); }
  .post-card__meta { display: flex; justify-content: space-between; align-items: center; }
  .post-card__time { font-size: 0.72rem; color: var(--text-muted); }
  .post-card__title { font-size: 1.15rem; line-height: 1.35; }
  .post-card__title a { color: inherit; text-decoration: none; }
  .post-card__title a::after { content: ''; position: absolute; inset: 0; }
  .post-card__title a:focus-visible { outline: none; }
  .post-card:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .post-card__desc { font-size: 0.92rem; font-weight: 300; line-height: 1.7; flex: 1; }
  .post-card__date { font-size: 0.75rem; color: var(--text-muted); padding-top: 16px; border-top: 1px solid var(--line); }
</style>
